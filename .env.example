# ==============================================================================
# Ahmed's WhatsApp Assistant — Environment Variables Template
# Copy this file to .env and provide your credentials before running the server.
# ==============================================================================

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# WAHA (WhatsApp HTTP API) Configuration
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_API_KEY=your_optional_waha_api_key

# Optional one-time replay cutoff for an existing WAHA installation.
# Use an ISO timestamp with Z or an explicit offset (for Karachi: +05:00).
# On first protected startup, this value (or that startup time when blank) is
# stored in SQLite and reused across restarts. Messages older than it are
# acknowledged but never passed to either the customer or owner AI path.
INBOUND_ACCEPT_AFTER=

# Shop Owner Authentication (Fail-closed E.164 format, e.g. 923001234567)
AHMED_OWNER_PHONE=923001234567

# Shared anti-ban pacing for the one WhatsApp sending number.
# Date-only values are interpreted at midnight in PACING_TIMEZONE.
# Missing or invalid activation dates fail closed to the day-0 20/day cap.
PACING_TIMEZONE=Asia/Karachi
PACING_NUMBER_ACTIVATED_ON=2026-09-04

# Server Configuration
PORT=3000
