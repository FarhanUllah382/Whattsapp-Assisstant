# ==============================================================================
# Ahmed's WhatsApp Assistant — Environment Variables Template
# Copy this file to .env and provide your credentials before running the server.
# ==============================================================================

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# WAHA (WhatsApp HTTP API) Configuration
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_API_KEY=your_optional_waha_api_key

# Shop Owner Authentication (Fail-closed E.164 format, e.g. 923001234567)
AHMED_OWNER_PHONE=923001234567

# Server Configuration
PORT=3000
