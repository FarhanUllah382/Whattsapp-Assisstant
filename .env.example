# ==============================================================================
# Ahmed's WhatsApp Assistant — Environment Variables Template
# Copy this file to .env and provide your credentials before running the server.
# ==============================================================================

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# The key is sent only in the x-goog-api-key header, never in the URL.
# Model name: letters, digits, dots and hyphens only; anything else (or blank)
# safely uses the default shown here.
GEMINI_MODEL=gemini-flash-lite-latest
# Per-call Gemini timeout in milliseconds (1-600000). A timed-out call counts
# against the AI budget as a failed call. Missing or invalid values use this
# finite default, never an unlimited wait.
GEMINI_TIMEOUT_MS=30000

# WAHA (WhatsApp HTTP API) Configuration
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_API_KEY=your_optional_waha_api_key
# Outbound sendText/sendImage timeout in milliseconds (1-300000). A timed-out
# send is recorded as delivery-uncertain (the message may have gone out) and is
# never retried automatically. Missing or invalid values use this finite default.
WAHA_SEND_TIMEOUT_MS=15000
# Separate shared secret used only to authenticate webhooks coming from WAHA.
# Configure the same value as WHATSAPP_HOOK_HMAC_KEY in the WAHA container.
WAHA_WEBHOOK_HMAC_KEY=generate_a_long_random_secret

# Optional minimum replay cutoff for an existing WAHA installation.
# Use an ISO timestamp with Z or an explicit offset (for Karachi: +05:00).
# Every application start advances the stored cutoff to that startup second;
# it never moves backward. Messages created while the webhook consumer was
# offline are acknowledged but never passed to either agent path.
INBOUND_ACCEPT_AFTER=

# Durable limits for model-backed inbound turns. STOP/START commands bypass
# this gate so a customer can always withdraw or restore consent. Missing or
# invalid values use the finite defaults shown here, never an unlimited mode.
INBOUND_RATE_WINDOW_MINUTES=10
INBOUND_CUSTOMER_TURNS_PER_WINDOW=20
INBOUND_OWNER_TURNS_PER_WINDOW=60

# Global Gemini budget shared by customer and owner turns, evaluated using the
# Karachi business day by default. Every provider attempt consumes the call
# allowance; successful responses also store Gemini's reported token usage.
# Missing or invalid values use these finite defaults, never unlimited access.
AI_BUDGET_TIMEZONE=Asia/Karachi
AI_DAILY_CALL_LIMIT=500
AI_DAILY_TOKEN_LIMIT=500000

# Durable inbound queue shared by customer and owner turns. Accepted messages
# are committed before WAHA receives HTTP 200; workers resume pending work after
# restart. Queue saturation returns HTTP 503 so the provider can retry safely.
INBOUND_JOB_WORKERS=4
INBOUND_JOB_MAX_PENDING=500
INBOUND_JOB_LEASE_SECONDS=300
INBOUND_JOB_MAX_ATTEMPTS=5
INBOUND_JOB_RETRY_BASE_SECONDS=30

# Operational endpoints and verified local SQLite backups. /health and /ready
# expose only minimal status. /operations/metrics fails closed unless this key
# is at least 24 characters and supplied in the X-Operations-Key header.
OPERATIONS_API_KEY=generate_a_separate_long_operations_key
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_DIRECTORY=backups/operations
DATABASE_BACKUP_INTERVAL_HOURS=24
DATABASE_BACKUP_RETENTION_COUNT=14

# Owner-alert flood ceiling. Excess alerts remain durable and grouped, then the
# existing retry worker delivers them after this rolling window has capacity.
OWNER_ALERT_WINDOW_MINUTES=10
OWNER_ALERT_MAX_SENDS_PER_WINDOW=6

# At most one deterministic overload reply per customer in this rolling period.
# The reply still obeys consent, normal pacing, and send idempotency.
BUSY_REPLY_COOLDOWN_MINUTES=10

# Shop Owner Authentication (Fail-closed E.164 format, e.g. 923001234567)
AHMED_OWNER_PHONE=923001234567

# Owner-controlled customer payment destinations. Leave a method completely
# blank to keep it unavailable. Never commit real payment details.
# Wallet numbers must be Pakistani 03XXXXXXXXX or 923XXXXXXXXX numbers.
PAYMENT_EASYPAISA_ACCOUNT_NAME=
PAYMENT_EASYPAISA_NUMBER=
PAYMENT_JAZZCASH_ACCOUNT_NAME=
PAYMENT_JAZZCASH_NUMBER=
# Bank transfer requires all three values and a 24-character Pakistani IBAN.
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_TITLE=
PAYMENT_BANK_IBAN=

# SHA-256 of the exact owner-approved catalog.md file. Policy answers fail
# closed when this is missing, malformed, or no longer matches the file.
# Recalculate and re-approve after every catalog/policy content change.
APPROVED_CATALOG_SHA256=

# Shared anti-ban pacing for the one WhatsApp sending number.
# Date-only values are interpreted at midnight in PACING_TIMEZONE.
# Missing or invalid activation dates fail closed to the day-0 20/day cap.
PACING_TIMEZONE=Asia/Karachi
PACING_NUMBER_ACTIVATED_ON=2026-09-04
# Optional exclusive closing hour (1-6 for after-midnight, or 8-24).
# Invalid values safely use 22.
PACING_WINDOW_END_HOUR=22

# Server Configuration
PORT=3000
