    {
      "type": "stat",
      "title": "Estimated cost today",
      "description": "Only shown when GEMINI_PRICE_INPUT_PER_MTOK and GEMINI_PRICE_OUTPUT_PER_MTOK are set in .env. Today = since local midnight in the browser time zone.",
      "id": 20,
      "datasource": {
        "type": "prometheus",
        "uid": "ahmed-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 19,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ahmed-prometheus"
          },
          "expr": "sum(increase(wa_estimated_cost_usd_total[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
