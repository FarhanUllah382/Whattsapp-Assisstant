{
  "name": "whatsapp-shop-agent",
  "version": "0.1.0",
  "description": "A single-tenant WhatsApp AI sales assistant for one clothing/footwear shop: customer conversations, orders and bookkeeping, owner mode, and production-hardening guardrails.",
  "license": "MIT",
  "author": "FarhanUllah382",
  "repository": {
    "type": "git",
    "url": "https://github.com/FarhanUllah382/whatsapp-shop-agent.git"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "backup": "tsx scripts/backup-database.ts",
    "backup:verify": "tsx scripts/verify-database-backup.ts",
    "catalog:verify-media": "tsx scripts/verify-product-media.ts",
    "live:verify": "tsx scripts/live-verify.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "test": "tsx scripts/run-isolated-tests.ts",
    "test:security": "tsx scripts/run-isolated-tests.ts --security",
    "test:e2e": "tsx scripts/run-isolated-tests.ts scripts/test-v2-flow.ts",
    "typecheck": "tsc --noEmit",
    "obs:up": "docker compose -f observability/docker-compose.yml up -d",
    "obs:down": "docker compose -f observability/docker-compose.yml down",
    "seed": "tsx scripts/seed-catalog.ts",
    "demo:seed": "tsx scripts/seed-portfolio-demo.ts",
    "demo:build": "npm run demo:seed && tsx scripts/build-portfolio-demo.ts",
    "demo:start": "tsx .portfolio-runtime/server.ts",
    "demo:verify": "tsx scripts/verify-portfolio-demo.ts",
    "cost:measure": "tsx scripts/run-isolated-tests.ts tests/turn-cost-harness.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
